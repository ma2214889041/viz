{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "viz-site",
  "account_id": "b407b9a9f1270b220d0218bd64282d7d",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // 语言游戏一文移除后，站点不再需要服务端共享状态：
  // Worker 只给 HTML 导航加 no-store，没有 Durable Object，也没有 API。
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "viz.gopromp.com",
      "custom_domain": true
    }
  ]
}
