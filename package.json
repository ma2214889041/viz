{
  "name": "viz-publication",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "preview": "npm run dev",
    "typecheck": "tsc --noEmit",
    "test:publication": "node tests/publication-audit.mjs",
    "test:optimization": "node tests/optimization-model.mjs",
    "test:multiplayer": "node tests/multiplayer-smoke.mjs",
    "deploy": "npm run build && npm run typecheck && npm run test:optimization && npm run test:publication && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260729.1",
    "typescript": "5.9.3",
    "wrangler": "4.115.0"
  }
}
